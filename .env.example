# ==============================================================================
# Deskline Service Request System - Environment Configuration
# ==============================================================================

# Database (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=deskline
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@db:5432/deskline?schema=public

# Backend API Configuration
PORT=4000
NODE_ENV=development
API_PREFIX=api
CORS_ORIGIN=http://localhost:3000

# Authentication & Security
# Access token lives in memory (15 min validity)
JWT_ACCESS_SECRET=deskline_access_secret_key_change_in_production_min32chars
JWT_ACCESS_EXPIRES_IN=15m

# Refresh token lives in httpOnly cookie scoped to /auth (7 days validity)
JWT_REFRESH_SECRET=deskline_refresh_secret_key_change_in_production_min32chars
JWT_REFRESH_EXPIRES_IN=7d

# Password Hashing & Rate Limiting
BCRYPT_SALT_ROUNDS=10
RATE_LIMIT_LOGIN_TTL=60
RATE_LIMIT_LOGIN_MAX=5

# SLA & Business Hours Engine
TIMEZONE=Asia/Kolkata
BUSINESS_START_HOUR=9
BUSINESS_END_HOUR=18
AUTO_CLOSE_DAYS=3

# Frontend (Vite)
VITE_PORT=3000
VITE_API_URL=/api
